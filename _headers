# Cloudflare Pages equivalent of the existing Netlify response-header policy.
# Keep hosted code/device-local media isolated; SoundCloud is the only intentional third-party exception.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://w.soundcloud.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; connect-src 'self' https://w.soundcloud.com; frame-src https://w.soundcloud.com; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=(), publickey-credentials-get=(), picture-in-picture=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Version manifest must always revalidate.
/version.json
  Cache-Control: public, max-age=0, must-revalidate

# Content-stable assets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/local/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/local/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.m4a
  Cache-Control: public, max-age=31536000, immutable

/*.zip
  Cache-Control: public, max-age=31536000, immutable

# Scripts/styles use versioned URLs; browser cache one hour.
/*.js
  Cache-Control: public, max-age=3600

/*.css
  Cache-Control: public, max-age=3600

/local/*.js
  Cache-Control: public, max-age=3600

/local/*.css
  Cache-Control: public, max-age=3600

# Service worker must revalidate so updates are discovered promptly.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
